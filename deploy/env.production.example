# Salin ke .env di server, lalu isi semua nilai yang kosong.
APP_NAME="NOTAGO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://toko.contoh.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta   # zona waktu toko (rekap harian, struk, jadwal)

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=notago
DB_USERNAME=notago
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Scan nota (OCR + AI)
OCR_DRIVER=openai
RECEIPT_AI_ENABLED=true
RECEIPT_SCAN_DISPATCH=sync
DB_QUEUE_RETRY_AFTER=660
RECEIPT_AI_MODEL=gpt-4.1-mini
RECEIPT_AI_DEBUG=false
OPENAI_API_KEY=

# WhatsApp (Fonnte) untuk pengingat bon & hutang
FONNTE_TOKEN=

# Toko
STORE_MODE=true
STORE_NAME="Toko Bangunan ..."
STORE_ADDRESS="Jl. ..."
STORE_PHONE=08...
STORE_RECEIPT_FOOTER="Terima kasih atas kunjungan Anda"
STORE_DEFAULT_MARGIN=15
STORE_CREDIT_DAYS=30
STORE_AUTO_RECEIVE=true
STORE_PAYABLE_REMINDER_DAYS=3
BACKUP_KEEP_DAYS=14
MYSQLDUMP_PATH=mysqldump
